/**index.wxss**/
/* 页面根节点 */
page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #e6e6fa;
}

/* 滚动区域 */
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

/* 主容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex: 1;
  position: relative;
}

/* 开始按钮 */
.start-btn {
  margin-top: 20rpx;
  width: 200rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #ffb347 0%, #ffcc33 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 204, 51, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  outline: none;
  transition: transform 0.15s cubic-bezier(.4,0,.2,1);
}

/* 开始按钮按下效果 */
.start-btn:active {
  transform: scale(0.96);
}

/* 指针外层容器 */
.pointer-wrapper {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 指针三角形 */
.pointer {
  width: 0;
  height: 0;    
  border-left: 24rpx solid transparent;
  border-right: 24rpx solid transparent;
  border-top: 32rpx solid #ffb347;
}

/* 转盘容器 */
.wheel-wrapper {
  margin: 40rpx auto 40rpx auto; /* ↑↓拉开空间 */
  position: relative;
  width: 600rpx;
  height: 600rpx;
  max-width: 90vw;
  max-height: 90vw;
  display: block;
}

/* 转盘canvas */
.wheel-canvas {
  width: 600rpx;
  height: 600rpx;
  max-width: 90vw;
  max-height: 90vw;
  display: block;
  margin: 0 auto 32rpx auto;
  box-sizing: border-box;
  background: #fff; /* 白色背景 */
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

/* 奖品说明区 */
.legend {
  width: 90vw;
  max-width: 650rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 16rpx;
  margin: 0 auto;
}

/* 奖品说明项 */
.legend-item {
  width: calc(50% - 12rpx);
  margin-bottom: 6rpx;
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.6;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* 奖品标签 */
.legend-label {
  font-weight: bold;
  margin-right: 12rpx;
  color: #ffb347;
}

/* 奖品文本 */
.legend-text {
  color: #333;
  word-break: break-all;
}

/* 控制按钮行 */
.control-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 90vw;
  max-width: 650rpx;
  margin: 160rpx auto 0 auto;
}

/* 配置按钮 */
.config-btn {
  width: auto;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #6ec6ff 0%, #4fa9f9 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(79, 169, 249, 0.2);
  border: none;
  outline: none;
  font-weight: bold;
  transition: opacity 0.2s, transform 0.15s cubic-bezier(.4,0,.2,1);
}

/* 配置按钮按下效果 */
.config-btn:active {
  opacity: 0.7;
  transform: scale(0.96);
}

/* 配置弹窗外层 */
.config-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 150vh;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

/* 弹窗遮罩 */
.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  top: 0;
  left: 0;
  z-index: 1000;
  pointer-events: auto;
}

/* 弹窗内容，绝对居中且可交互 */
.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80vw;
  max-width: 600rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  z-index: 1001;
  pointer-events: auto;
  overflow: hidden; /* 防止内容溢出弹窗 */
  display: flex;
  flex-direction: column;
}

/* 弹窗关闭按钮 */
.close-icon {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  font-size: 36rpx;
  color: #dd4949;
  text-align: center;
  line-height: 48rpx;
  z-index: 102;
}




/* 奖品项 */
.prize-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background-color: #f8f8f8;
  font-size: 28rpx;
  width: 100%;
  max-width: 500rpx;
}

/* 奖品删除按钮 */
.delete-icon {
  font-size: 50rpx;
  color: #6d6c6c;
  margin-left: 24rpx;
  cursor: pointer;
}

/* 弹窗按钮 */
.modal-btn {
  width: 100%;
  margin-top: 16rpx;
  margin-bottom: 0;
  padding: 18rpx 0;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
  outline: none;
  background: linear-gradient(90deg, #ffb347 0%, #ffcc33 100%);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 204, 51, 0.10);
  transition: opacity 0.2s, transform 0.15s cubic-bezier(.4,0,.2,1);
  display: block;
}

/* 弹窗按钮按下效果 */
.modal-btn:active {
  opacity: 0.7;
  transform: scale(0.97);
}



/* 添加按钮 */
.add-btn {
  background: linear-gradient(90deg, #6ec6ff 0%, #4fa9f9 100%);
  margin-top: 32rpx; /* 增加上方间距 */
}

/* 保存按钮 */
.save-btn {
  background: linear-gradient(90deg, #ffb347 0%, #ffcc33 100%);
}

/* 重置按钮 */
.reset-btn {
  background: linear-gradient(90deg, #f66 0%, #ffb347 100%);
}

/* 奖品列表滚动区 */
.prize-scroll {
  flex: 1 1 auto; /* 自动撑满剩余空间 */
  min-height: 120rpx;
  max-height: 40vh; /* 限制最大高度，超出可滚动 */
  overflow-y: auto;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
}

/* 图例滚动区域，显示3行内容 */
.legend-scroll {
  width: 90vw;
  max-width: 650rpx;
  height: 320rpx; /* 3行，每行约64rpx（含间距），可根据实际legend-item高度微调 */
  margin: 0 auto 24rpx auto;
  overflow-y: auto;
}

/* 弹窗浮层，独立于主内容布局 */
.config-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  pointer-events: none; /* 不干扰主页面布局和事件 */
}

